# Conexión DIRECTA (sin pgbouncer) — la usa la app en runtime Y Prisma
# para migraciones. Medido en vivo (sesión 2026-09-14): con pgbouncer
# (puerto 6543, modo transacción) cada query tardaba ~1170ms incluso con
# la conexión ya abierta — 5x más que la conexión directa (~230ms). El
# pooler existe para arquitecturas donde MUCHOS procesos livianos (típico
# serverless) comparten pocas conexiones reales a Postgres; este backend
# es un solo proceso persistente con una sola conexión (PrismaService es
# singleton, conecta una vez) — no tiene el problema que pgbouncer
# resuelve, y pagaba el costo del pooler sin ninguno de sus beneficios.
# Mismo valor que DIRECT_URL a propósito.
DATABASE_URL="postgresql://user:password@localhost:5432/app_gimnasio"

# Conexión directa — la usa Prisma para migraciones (requerido por Prisma
# incluso si DATABASE_URL ya es directa, para separar el rol de conexión
# de runtime del de migraciones si en el futuro DATABASE_URL vuelve a
# necesitar un pooler).
DIRECT_URL="postgresql://user:password@localhost:5432/app_gimnasio"

# Nota: NO hace falta SUPABASE_JWT_SECRET. JwtAuthGuard verifica los JWT
# contra la JWKS pública del proyecto (SUPABASE_URL + /auth/v1/.well-known/
# jwks.json), asimétrico (ES256) — el modo actual de Supabase para
# proyectos nuevos. El "Legacy JWT Secret" (HS256 compartido) de Project
# Settings > API sirve solo para tokens emitidos ANTES de una rotación a
# JWT Signing Keys — no lo uses acá, no verifica tokens nuevos.

# Supabase Admin API — SOLO server-side, nunca en variables NEXT_PUBLIC_*
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# Derivación determinística de la password interna de alumnos (HMAC-SHA256).
# Propia, distinta de SUPABASE_JWT_SECRET. Sin valor real acá.
#
# TRAMPA REAL (pasó en esta sesión): local y Render/producción apuntan a
# la MISMA base de Supabase Auth — no hay DB separada por ambiente. La
# password real de un alumno se fija en Supabase en el momento en que se
# crea (derivada con el valor de este secret EN ESE MOMENTO), no se
# recalcula después. Si este valor difiere entre tu .env local y el de
# Render, el login de alumno falla en el ambiente con el secret viejo —
# aunque el otro ambiente funcione perfecto. Si rotás este secret en un
# ambiente, actualizalo en TODOS los ambientes que comparten la misma
# base de Supabase, o los alumnos ya creados quedan sin poder loguearse
# en el ambiente que se quedó atrás.
AUTH_DERIVE_SECRET="tu-secret-propio-para-derivar-passwords-de-alumnos"

# CORS — origen(es) permitidos para llamadas directas browser→API, separados
# por coma (ej. "https://app-gimnasio.vercel.app,https://app-gimnasio-git-preview.vercel.app").
# Nunca "*". Sin esta var, solo se permite http://localhost:3000 (dev local).
# El proxy BFF de apps/web y `apiFetch` son server-to-server y no pasan por
# CORS — esto es para cualquier llamada directa desde el browser.
CORS_ORIGIN="https://tu-proyecto.vercel.app"

# Puerto — solo para dev local (`app.listen` cae a 3001 si falta esta var).
# En Render NO se carga: la plataforma inyecta su propio PORT en runtime y
# `main.ts` ya lo respeta (`process.env.PORT ?? 3001`).
PORT="3001"

# Opcional — checkout local de https://github.com/hasaneyldrm/exercises-dataset,
# usado por `pnpm seed:exercises` y `pnpm upload-exercise-media` para cargar
# el catálogo real (1.324 ejercicios). Sin esto, seed:exercises usa el
# fixture de 2 items (apps/api/prisma/seed-exercises.fixture.json).
EXERCISES_DATASET_PATH="/ruta/a/tu/checkout/exercises-dataset"
