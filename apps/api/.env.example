# Pooled connection (pgbouncer, transaction mode) — usada por la app en runtime.
DATABASE_URL="postgresql://user:password@localhost:6543/app_gimnasio?pgbouncer=true"

# Conexión directa (sin pooler) — usada solo por Prisma para migraciones.
DIRECT_URL="postgresql://user:password@localhost:5432/app_gimnasio"

# Nota: NO hace falta SUPABASE_JWT_SECRET. JwtAuthGuard verifica los JWT
# contra la JWKS pública del proyecto (SUPABASE_URL + /auth/v1/.well-known/
# jwks.json), asimétrico (ES256) — el modo actual de Supabase para
# proyectos nuevos. El "Legacy JWT Secret" (HS256 compartido) de Project
# Settings > API sirve solo para tokens emitidos ANTES de una rotación a
# JWT Signing Keys — no lo uses acá, no verifica tokens nuevos.

# Supabase Admin API — SOLO server-side, nunca en variables NEXT_PUBLIC_*
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# Derivación determinística de la password interna de alumnos (HMAC-SHA256).
# Propia, distinta de SUPABASE_JWT_SECRET. Sin valor real acá.
AUTH_DERIVE_SECRET="tu-secret-propio-para-derivar-passwords-de-alumnos"

# CORS — origen(es) permitidos para llamadas directas browser→API, separados
# por coma (ej. "https://app-gimnasio.vercel.app,https://app-gimnasio-git-preview.vercel.app").
# Nunca "*". Sin esta var, solo se permite http://localhost:3000 (dev local).
# El proxy BFF de apps/web y `apiFetch` son server-to-server y no pasan por
# CORS — esto es para cualquier llamada directa desde el browser.
CORS_ORIGIN="https://tu-proyecto.vercel.app"

# Puerto — solo para dev local (`app.listen` cae a 3001 si falta esta var).
# En Render NO se carga: la plataforma inyecta su propio PORT en runtime y
# `main.ts` ya lo respeta (`process.env.PORT ?? 3001`).
PORT="3001"

# Opcional — checkout local de https://github.com/hasaneyldrm/exercises-dataset,
# usado por `pnpm seed:exercises` y `pnpm upload-exercise-media` para cargar
# el catálogo real (1.324 ejercicios). Sin esto, seed:exercises usa el
# fixture de 2 items (apps/api/prisma/seed-exercises.fixture.json).
EXERCISES_DATASET_PATH="/ruta/a/tu/checkout/exercises-dataset"
