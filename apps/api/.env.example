# Pooled connection (pgbouncer, transaction mode) — usada por la app en runtime.
DATABASE_URL="postgresql://user:password@localhost:6543/app_gimnasio?pgbouncer=true"

# Conexión directa (sin pooler) — usada solo por Prisma para migraciones.
DIRECT_URL="postgresql://user:password@localhost:5432/app_gimnasio"

# Nota: NO hace falta SUPABASE_JWT_SECRET. JwtAuthGuard verifica los JWT
# contra la JWKS pública del proyecto (SUPABASE_URL + /auth/v1/.well-known/
# jwks.json), asimétrico (ES256) — el modo actual de Supabase para
# proyectos nuevos. El "Legacy JWT Secret" (HS256 compartido) de Project
# Settings > API sirve solo para tokens emitidos ANTES de una rotación a
# JWT Signing Keys — no lo uses acá, no verifica tokens nuevos.

# Supabase Admin API — SOLO server-side, nunca en variables NEXT_PUBLIC_*
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# Derivación determinística de la password interna de alumnos (HMAC-SHA256).
# Propia, distinta de SUPABASE_JWT_SECRET. Sin valor real acá.
AUTH_DERIVE_SECRET="tu-secret-propio-para-derivar-passwords-de-alumnos"
